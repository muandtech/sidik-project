# Koneksi MySQL XAMPP
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sidik_db

# Rahasia untuk tanda tangan CAPTCHA — isi dengan string acak panjang
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Isi true HANYA bila aplikasi berjalan di belakang reverse proxy (Nginx/Caddy) yang mengisi header
# X-Real-IP / X-Forwarded-For. Tanpa proxy, header itu bisa dipalsukan klien sehingga IP tidak dipercaya
# dan rate limiting login hanya berjalan per akun.
# Contoh Nginx: proxy_set_header X-Real-IP $remote_addr;
TRUST_PROXY=false
